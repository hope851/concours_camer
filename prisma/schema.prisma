generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ees {
  id                     String                 @id @default(uuid())
  domaine                String
  eesBio                 String?
  eesType                String
  nomEes                 String
  posGeoLatitude         Float?
  posGeoLongitude        Float?
  siteEes                String?
  logoEes                String?
  tutelleId              String
  villeId                String
  news                   News[]
  followusers            FollowEes[]
  tutelleInstitutionelle tutelleInstitutionelle @relation(fields: [tutelleId], references: [id])
  ville                  ville                  @relation(fields: [villeId], references: [id])
  programme              Programme[]
  sessionAdmission       sessionAdmission[]
  users                  users[]                @relation("EESToUsers")
}

model FollowEes {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade) 
  eesId     String
  ees       ees      @relation(fields: [eesId], references: [id], onDelete: Cascade)
  @@unique([userId, eesId])
}


model FollowTutelle {
  id        String                   @id @default(uuid())
  createdAt DateTime                 @default(now())
  userId    String
  user      users                    @relation(fields: [userId], references: [id], onDelete: Cascade) 
  tutelleId String
  tutelle   tutelleInstitutionelle   @relation(fields: [tutelleId], references: [id], onDelete: Cascade)
  @@unique([userId, tutelleId])
}

model FollowProgramme {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String
  user        users    @relation(fields: [userId], references: [id], onDelete: Cascade) 
  programmeId String
  programme  Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  @@unique([userId, programmeId])
}

model News {
  id         String                  @id @default(uuid())
  title      String
  image      String?
  excerpt    String       
  content    String                 @db.Text
  category   String
  slug       String                   @unique
  createdAt  DateTime                 @default(now())
  isUrgent   Boolean                  @default(false)
  sourceName String?
  sourceUrl  String?
  contenthash String                  @unique
  eesId      String?
  ees        ees?                     @relation(fields: [eesId], references: [id])
  tutelleId  String?
  tutelle  tutelleInstitutionelle?    @relation(fields: [tutelleId], references: [id])
  programmeId  String?
  programme  Programme?               @relation(fields: [programmeId], references: [id])
}

model Pays {
  id                     String                   @id @default(uuid())
  nomPays                String                   @unique
  region                 String
  imgGrapeau             String?
  tutelleInstitutionelle tutelleInstitutionelle[]
  ville                  ville[]
}

model Programme {
  id               String            @id @default(uuid())
  nomProgramme     String
  specialite       String?
  niveau           String
  followProgramme  FollowProgramme[]
  eesId            String
  ees              ees               @relation(fields: [eesId], references: [id], onDelete: Cascade)
  sessionAdmission sessionAdmission?
  news             News[]
  @@unique([nomProgramme, specialite, niveau, eesId])
}

model sessionAdmission {
  id            String     @id @default(uuid())
  nomConcours   String
  etat          Boolean    @default(false)
  concoursBio   String?
  dateOuverture DateTime
  limiteDepot   DateTime
  dateExamEcrit DateTime?
  dateExamOral  DateTime?
  diplomeRequis String
  adressExam    String?
  eesId         String
  programmeId   String?    @unique
  ees           ees        @relation(fields: [eesId], references: [id], onDelete: Cascade)
  programme     Programme? @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([nomConcours, eesId, programmeId])
}

model tutelleInstitutionelle {
  id             String           @id @default(uuid())
  nomTutelle     String
  nomTutelleTech String?
  tutelleBio     String?
  siteTutelle    String?
  logoTutelle    String?
  paysId         String
  news           News[]
  followUser     FollowTutelle[]
  ees            ees[]
  pays           Pays             @relation(fields: [paysId], references: [id])
}

model users {
  id               String             @id @default(uuid())
  email            String             @unique
  password         String
  nom              String
  role             Role               @default(USER)
  dateInscription  DateTime           @default(now())
  isActive         Boolean            @default(true)
  folowingPrograme FollowProgramme[]
  folowingEes      FollowEes[]
  folowingTutelle  FollowTutelle[]
  ees              ees[]              @relation("EESToUsers")
}

model ville {
  id       String @id @default(uuid())
  nomVille String
  paysId   String
  ees      ees[]
  pays     Pays   @relation(fields: [paysId], references: [id])

  @@unique([nomVille, paysId])
}

enum Role {
  ADMIN
  GESTIONAIRE
  USER
}
